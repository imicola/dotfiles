input {
 keyboard { xkb { layout "us"; options "caps:swapescape"; }; numlock; }
 touchpad { tap; natural-scroll; dwt; }
}
output "eDP-1" {
 mode "3120x2080@120"
 scale 1.75
 position x=0 y=0
}
output "HDMI-A-1" {
    mode "2560x1440@100"
    scale 1.25
}
layout {
 gaps 10
 center-focused-column "on-overflow"
 preset-column-widths { proportion 0.5; proportion 0.66667; proportion 1.0; }
 default-column-width { proportion 0.66667; }
 focus-ring { width 2; active-color "#b8a1e3"; inactive-color "#454c65"; }
 border { off; }
 shadow { on; softness 24; spread 1; offset x=0 y=5; color "#00000040"; }
}
cursor { xcursor-theme "HydrangeaNight-cursors"; xcursor-size 24; }
environment {
 QT_QPA_PLATFORMTHEME "kde"
 XCURSOR_THEME "HydrangeaNight-cursors"
 XCURSOR_SIZE "24"
 BROWSER "firefox"
 XMODIFIERS "@im=fcitx"
 QT_IM_MODULE "fcitx"
 HTTP_PROXY "http://127.0.0.1:7897"
 HTTPS_PROXY "http://127.0.0.1:7897"
 http_proxy "http://127.0.0.1:7897"
 https_proxy "http://127.0.0.1:7897"
 all_proxy "http://127.0.0.1:7897"
 ALL_PROXY "http://127.0.0.1:7897"
 no_proxy "localhost,127.0.0.1,::1"
 NO_PROXY "localhost,127.0.0.1,::1"
}
spawn-at-startup "systemctl" "--user" "start" "noctalia.service"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
// Desktop autostart target starts Clash and Fcitx5.
screenshot-path "~/Pictures/Screenshots/Screenshot-%Y-%m-%d-%H-%M-%S.png"
prefer-no-csd
window-rule {
 geometry-corner-radius 11
 clip-to-geometry true
 draw-border-with-background false
}
window-rule {
 match app-id=r#"^(org.pulseaudio.pavucontrol|blueman-manager|nm-connection-editor)$"#
 open-floating true
}
binds {
 // Clavis 借鉴：统一工具入口、剪贴板、媒体与窗口切换。
 Mod+D hotkey-overlay-title="快捷工具：剪贴板、计算器、表情、窗口、媒体" { spawn "/home/imicola/.local/bin/niri-tools"; }
 Mod+Shift+V hotkey-overlay-title="搜索剪贴板历史" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
 Mod+Shift+C hotkey-overlay-title="计算器与单位换算" { spawn "noctalia" "msg" "panel-toggle" "launcher" "/calc "; }
 Mod+Period hotkey-overlay-title="搜索并复制表情符号" { spawn "noctalia" "msg" "panel-toggle" "launcher" "/emo "; }
 Mod+M hotkey-overlay-title="媒体面板：封面、进度和播放器" { spawn "noctalia" "msg" "panel-toggle" "control-center" "media"; }
 Mod+Tab hotkey-overlay-title="按最近使用顺序切换窗口" { spawn "noctalia" "msg" "window-switcher" "hold"; }
 Mod+Ctrl+D hotkey-overlay-title="显示／隐藏底部 Dock" { spawn "noctalia" "msg" "dock-toggle"; }

 Mod+C hotkey-overlay-title="控制中心" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
 Mod+N hotkey-overlay-title="通知历史" { spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications"; }
 Mod+W hotkey-overlay-title="壁纸选择" { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
 Mod+Shift+D hotkey-overlay-title="切换勿扰模式" { spawn "noctalia" "msg" "notification-dnd-toggle"; }

 Mod+T hotkey-overlay-title="打开 Kitty 终端" { spawn "kitty"; }
 Mod+Return hotkey-overlay-title="打开 Kitty 终端" { spawn "kitty"; }
 Ctrl+Alt+T hotkey-overlay-title="打开 Kitty 终端" { spawn "kitty"; }
 Alt+Space hotkey-overlay-title="搜索并打开应用" { spawn "/home/imicola/.local/bin/niri-launcher"; }
 Mod+X hotkey-overlay-title="会话菜单：锁屏、注销、重启和关机" { spawn "/home/imicola/.local/bin/niri-power-menu"; }
 Mod+E hotkey-overlay-title="打开文件管理器" { spawn "dolphin"; }
 Mod+B hotkey-overlay-title="打开 Firefox 浏览器" { spawn "firefox"; }
 Mod+Shift+B hotkey-overlay-title="打开 Edge 备用浏览器" { spawn "microsoft-edge-stable"; }
 Mod+Q hotkey-overlay-title="关闭当前窗口" { close-window; }
 Mod+Shift+Slash hotkey-overlay-title="中文快捷键与使用提示" { spawn "/home/imicola/.local/bin/niri-help"; }
 Mod+Ctrl+Slash hotkey-overlay-title="Niri 原生快捷键面板" { show-hotkey-overlay; }
 Mod+Left hotkey-overlay-title="聚焦左侧窗口列" { focus-column-left; }
 Mod+Right hotkey-overlay-title="聚焦右侧窗口列" { focus-column-right; }
 Mod+Up hotkey-overlay-title="聚焦同列上方窗口" { focus-window-up; }
 Mod+Down hotkey-overlay-title="聚焦同列下方窗口" { focus-window-down; }
 Mod+H hotkey-overlay-title="聚焦左侧窗口列" { focus-column-left; }
 Mod+L hotkey-overlay-title="聚焦右侧窗口列" { focus-column-right; }
 Mod+J hotkey-overlay-title="聚焦同列下方窗口" { focus-window-down; }
 Mod+K hotkey-overlay-title="聚焦同列上方窗口" { focus-window-up; }
 Mod+Shift+Left hotkey-overlay-title="整列向左移动" { move-column-left; }
 Mod+Shift+Right hotkey-overlay-title="整列向右移动" { move-column-right; }
 Mod+Shift+Up hotkey-overlay-title="窗口在列内上移" { move-window-up; }
 Mod+Shift+Down hotkey-overlay-title="窗口在列内下移" { move-window-down; }
 Mod+Shift+H hotkey-overlay-title="窗口列向左移动" { move-column-left; }
 Mod+Shift+J hotkey-overlay-title="窗口在同列中下移" { move-window-down; }
 Mod+Shift+K hotkey-overlay-title="窗口在同列中上移" { move-window-up; }
 Mod+Shift+L hotkey-overlay-title="窗口列向右移动" { move-column-right; }
 Mod+Ctrl+Left hotkey-overlay-title="当前窗口并入左列／从列中拆出" { consume-or-expel-window-left; }
 Mod+Ctrl+Right hotkey-overlay-title="当前窗口并入右列／从列中拆出" { consume-or-expel-window-right; }
 Mod+Alt+Up hotkey-overlay-title="切换到上一个工作区" { focus-workspace-up; }
 Mod+Alt+Down hotkey-overlay-title="切换到下一个工作区" { focus-workspace-down; }
 Mod+Alt+Shift+Up hotkey-overlay-title="当前窗口移到上一个工作区" { move-window-to-workspace-up; }
 Mod+Alt+Shift+Down hotkey-overlay-title="当前窗口移到下一个工作区" { move-window-to-workspace-down; }
 Mod+1 hotkey-overlay-title="切换到工作区 1" { focus-workspace 1; }
 Mod+Shift+1 hotkey-overlay-title="当前窗口移到工作区 1" { move-window-to-workspace 1; }
 Mod+2 hotkey-overlay-title="切换到工作区 2" { focus-workspace 2; }
 Mod+Shift+2 hotkey-overlay-title="当前窗口移到工作区 2" { move-window-to-workspace 2; }
 Mod+3 hotkey-overlay-title="切换到工作区 3" { focus-workspace 3; }
 Mod+Shift+3 hotkey-overlay-title="当前窗口移到工作区 3" { move-window-to-workspace 3; }
 Mod+4 hotkey-overlay-title="切换到工作区 4" { focus-workspace 4; }
 Mod+Shift+4 hotkey-overlay-title="当前窗口移到工作区 4" { move-window-to-workspace 4; }
 Mod+5 hotkey-overlay-title="切换到工作区 5" { focus-workspace 5; }
 Mod+Shift+5 hotkey-overlay-title="当前窗口移到工作区 5" { move-window-to-workspace 5; }
 Mod+6 hotkey-overlay-title="切换到工作区 6" { focus-workspace 6; }
 Mod+Shift+6 hotkey-overlay-title="当前窗口移到工作区 6" { move-window-to-workspace 6; }
 Mod+7 hotkey-overlay-title="切换到工作区 7" { focus-workspace 7; }
 Mod+Shift+7 hotkey-overlay-title="当前窗口移到工作区 7" { move-window-to-workspace 7; }
 Mod+8 hotkey-overlay-title="切换到工作区 8" { focus-workspace 8; }
 Mod+Shift+8 hotkey-overlay-title="当前窗口移到工作区 8" { move-window-to-workspace 8; }
 Mod+9 hotkey-overlay-title="切换到工作区 9" { focus-workspace 9; }
 Mod+Shift+9 hotkey-overlay-title="当前窗口移到工作区 9" { move-window-to-workspace 9; }
 Mod+Minus hotkey-overlay-title="缩窄窗口列 5%" { set-column-width "-5%"; }
 Mod+Equal hotkey-overlay-title="加宽窗口列 5%" { set-column-width "+5%"; }
 Mod+Shift+Minus hotkey-overlay-title="降低窗口高度 5%" { set-window-height "-5%"; }
 Mod+Shift+Equal hotkey-overlay-title="增加窗口高度 5%" { set-window-height "+5%"; }
 Mod+R hotkey-overlay-title="轮换预设列宽（还可用加减键微调）" { switch-preset-column-width; }
 Mod+F hotkey-overlay-title="切换整列最大化" { maximize-column; }
 Mod+Shift+F hotkey-overlay-title="切换当前窗口全屏" { fullscreen-window; }
 Mod+V hotkey-overlay-title="切换浮动／平铺" { toggle-window-floating; }
 Mod+Shift+O hotkey-overlay-title="切换当前窗口不透明／半透明" { toggle-window-rule-opacity; }
 Mod+Space hotkey-overlay-title="打开／关闭窗口总览" { toggle-overview; }
 Mod+S hotkey-overlay-title="框选截图（保存并复制）" { screenshot; }
 Ctrl+Print hotkey-overlay-title="全屏截图" { screenshot-screen; }
 Alt+Print hotkey-overlay-title="当前窗口截图" { screenshot-window; }
 Mod+Escape hotkey-overlay-title="允许／禁止应用独占快捷键" { toggle-keyboard-shortcuts-inhibit; }
 Mod+Shift+E hotkey-overlay-title="退出 Niri，返回登录界面（有确认）" { quit; }
 Mod+Ctrl+L hotkey-overlay-title="锁屏（使用登录密码解锁）" { spawn "/home/imicola/.local/bin/niri-lock"; }
 XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="音量增加 5%" { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
 XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="音量降低 5%" { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
 XF86AudioMute allow-when-locked=true hotkey-overlay-title="扬声器静音切换" { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
 XF86AudioMicMute allow-when-locked=true hotkey-overlay-title="麦克风静音切换" { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
 XF86MonBrightnessUp hotkey-overlay-title="亮度增加 5%" { spawn "brightnessctl" "set" "+5%"; }
 XF86MonBrightnessDown hotkey-overlay-title="亮度降低 5%" { spawn "brightnessctl" "set" "5%-"; }
 XF86AudioPlay hotkey-overlay-title="播放／暂停" { spawn "playerctl" "play-pause"; }
 XF86AudioNext hotkey-overlay-title="下一首" { spawn "playerctl" "next"; }
 XF86AudioPrev hotkey-overlay-title="上一首" { spawn "playerctl" "previous"; }
}

// 中文速查表作为浮动窗口显示。
hotkey-overlay { skip-at-startup; }
window-rule {
 match title="^Niri 快捷键与使用提示$"
 match app-id="^niri-help$"
 open-floating true
 default-column-width { fixed 980; }
 default-window-height { fixed 800; }
}

// 工作区、窗口切换和总览采用无回弹过渡。
animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=230 epsilon=0.001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=250 epsilon=0.001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=260 epsilon=0.001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=260 epsilon=0.001
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=220 epsilon=0.001
    }
}

blur {
    passes 3
    offset 3
    noise 0.02
    saturation 1.5
}

// 给有透明背景的窗口启用背景模糊，沿用应用本身的透明度。
window-rule {
    background-effect {
        blur true
        xray true
    }
}

// 全局窗口半透明：聚焦窗口 0.90，非聚焦窗口 0.85（可按 Super+Shift+O 临时切回完全不透明）。
window-rule {
    opacity 0.90
}
window-rule {
    match is-active=false
    opacity 0.85
}
// 排除浏览器、视频播放器、自带原生背景透明的 Kitty 终端和 Noctalia 设置窗口，避免看视频/图片变透或重复叠加透明度。
window-rule {
    match app-id=r#"^(firefox|microsoft-edge|microsoft-edge-stable|google-chrome|chromium|mpv|vlc|kitty|dev\.noctalia\.Noctalia)$"#
    opacity 1.0
}

// Noctalia 自己请求正确形状的 blur region。
// 顶层面板使用普通取样；尚未安装 Noctalia 时本规则没有匹配对象。
layer-rule {
    match namespace=r#"^noctalia-(bar-[^"]+|notification|dock|panel|attached-panel|osd)$"#
    background-effect {
        xray false
    }
}

// 紫阳花夜色：概览使用 Noctalia 专用背景。
layer-rule {
 match namespace="^noctalia-backdrop"
 place-within-backdrop true
}
window-rule {
 match app-id=r#"^dev\.noctalia\.Noctalia$"#
 open-floating true
}


include "noctalia.kdl"

include "kando.kdl"
